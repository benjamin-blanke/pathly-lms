# Pathly's backend is self-hosted (see docker/) — no Supabase Cloud account
# needed. install.sh generates all three of these automatically for a VPS
# deploy; for local dev, see "Start the backend" in the README.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — never expose to the client.
# Used only by the calendar ICS feed (/calendar/feed/[token]), which is
# authenticated by the token itself rather than a Supabase session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
